+ static int sgroups_qsort_aux(const void *a, const void *b)
+ {
+ 	const gid_t *ag = a, *bg = b;
+ 	if ( *ag < *bg ) return -1;
+ 	if ( *ag > *bg ) return +1;
+ 	return 0;
+ }
+ 
+ int prepare_sgids(struct lxc_conf *c)
+ {
+ 	const bool new_namespace = !lxc_list_empty(&c->id_map);
+ 
+ 	/* if we are in a new user namespace, we must always reset the supplementary
+ 	 * groups, otherwise, only reset them if either of the declarations is seen.
+ 	 */
+ 	c->sgids.setgroups = new_namespace || c->sgids.group_user || !lxc_list_empty(&c->sgids.groups);
+ 	c->sgids.ngids = 0;
+ 
+ 	if (c->sgids.setgroups) {
+ 		struct lxc_list *it,*next;
+ 
+ 		if (c->sgids.group_user) {
+ 			/* A username whose groups should become the set of groups was specified */
+ 			char buffer[BUFSIZ];
+ 			struct passwd pwd, *result;
+ 			int ngroups = NGROUPS_MAX;
+ 			if (getpwnam_r(c->sgids.group_user, &pwd, buffer, sizeof(buffer), &result)) {
+ 				SYSERROR("UID lookup for '%s' failed", c->sgids.group_user);
+ 				return 1;
+ 			}
+ 			if (result == NULL) {
+ 				ERROR("UID lookup for '%s' failed", c->sgids.group_user);
+ 				return 1;
+ 			}
+ 			if (getgrouplist(c->sgids.group_user, result->pw_gid, c->sgids.gids, &ngroups) == -1) {
+ 				SYSERROR("getgrouplist lookup for '%s' failed", c->sgids.group_user);
+ 			}
+ 			c->sgids.ngids = (size_t) ngroups;
+ 		}
+ 		else if (!new_namespace) {
+ 			/* No username specified, so use the current user's groups which will then be added to below */
+ 			int ngroups = getgroups(NGROUPS_MAX, c->sgids.gids);
+ 			if (ngroups == -1) {
+ 				SYSERROR("Current GID lookup failed\n");
+ 				return 1;
+ 			}
+ 			c->sgids.ngids = (size_t) ngroups;
+ 		}
+ 
+ 		if (c->sgids.ngids + lxc_list_len(&c->sgids.groups) >= NGROUPS_MAX) {
+ 			ERROR("Too many supplementary groups specified - max %u", NGROUPS_MAX);
+ 			return 1;
+ 		}
+ 
+ 		lxc_list_for_each_safe(it, &c->sgids.groups, next) {
+ 			char buffer[BUFSIZ], *ename;
+ 			struct group grp, *result;
+ 			const char *name = it->elem;
+ 
+ 			/* Try to see if it's numeric first, as getgrnam_r doesn't do so */
+ 			errno = 0;
+ 			grp.gr_gid = (gid_t) strtoul(name, &ename, 10);
+ 			if (errno == 0 && ename && *ename == '\0') {
+ 				result = &grp;
+ 			}
+ 			else if (getgrnam_r(name, &grp, buffer, sizeof(buffer), &result)) {
+ 				SYSERROR("GID lookup for '%s' failed", name);
+ 				return 1;
+ 			}
+ 			if (result == NULL) {
+ 				ERROR("GID lookup for '%s' failed", name);
+ 				return 1;
+ 			}
+ 			c->sgids.gids[c->sgids.ngids++] = result->gr_gid;
+ 		}
+ 
+ 		if (new_namespace) {
+ 			/* Map all the resulting GIDs into the new namespace */
+ 			size_t i;
+ 
+ 			for (i = 0; i != c->sgids.ngids; ++i) {
+ 				int mapped_gid = mapped_hostid(c->sgids.gids[i], c, ID_TYPE_GID);
+ 				if (mapped_gid == -1) {
+ 					ERROR("GID mapping failed for '%u'", c->sgids.gids[i]);
+ 					return 1;
+ 				}
+ 				c->sgids.gids[i] = (gid_t) mapped_gid;
+ 			}
+ 		}
+ 
+ 		/* Sort into numeric order for cosmetics and to simplify duplicate removal */
+ 		if (c->sgids.ngids > 1) {
+ 			qsort(c->sgids.gids, c->sgids.ngids, sizeof(c->sgids.gids[0]), sgroups_qsort_aux);
+ 			size_t i, j;
+ 
+ 			for (i = 0, j = 1; j != c->sgids.ngids; ++j) {
+ 				if (c->sgids.gids[i] != c->sgids.gids[j]) {
+ 					c->sgids.gids[++i] = c->sgids.gids[j];
+ 				}
+ 			}
+ 
+ 			c->sgids.ngids = i + 1;
+ 		}
+ 	}
+ 
+ 	return 0;
+ }
