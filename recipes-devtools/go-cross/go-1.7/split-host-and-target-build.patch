From: xione
Subject: Use correct version of runc for sky-dobby
Source: COMCAST
License: BSD-3
Upstream-Status: Pending
Signed-off-by: Kamal Mortoza <kamal.mortoza@sky.uk>

From 7706cff95d1aa022244b6986d7612caa2dbec02e Mon Sep 17 00:00:00 2001
From: Antti Kyllonen <antti.kyllonen@redembedded.com>
Date: Mon, 21 Oct 2019 16:57:02 +0100
Subject: [PATCH] split-host-and-target-build

---
 src/make.bash | 39 ++++++++++++++++++++++++++++++---------
 1 file changed, 30 insertions(+), 9 deletions(-)

diff --git a/src/make.bash b/src/make.bash
index 489ed21..16abd22 100755
--- a/src/make.bash
+++ b/src/make.bash
@@ -154,13 +154,23 @@ if [ "$1" = "--no-clean" ]; then
 	buildall=""
 	shift
 fi
-./cmd/dist/dist bootstrap $buildall $GO_DISTFLAGS -v # builds go_bootstrap
 
-# Delay move of dist tool to now, because bootstrap may clear tool directory.
-mv cmd/dist/dist "$GOTOOLDIR"/dist
-echo
+do_host_build="yes"
+do_target_build="yes"
+if [ "$1" = "--target-only" ]; then
+       do_host_build="no"
+       shift
+elif [ "$1" = "--host-only" ]; then
+       do_target_build="no"
+       shift
+fi
+
+if [ "$do_host_build" = "yes" ]; then
+        ./cmd/dist/dist bootstrap $buildall $GO_DISTFLAGS -v # builds go_bootstrap
+        # Delay move of dist tool to now, because bootstrap may clear tool directory.
+        mv cmd/dist/dist "$GOTOOLDIR"/dist
+        echo
 
-if [ "$GOHOSTARCH" != "$GOARCH" -o "$GOHOSTOS" != "$GOOS" ]; then
 	echo "##### Building packages and commands for host, $GOHOSTOS/$GOHOSTARCH."
 	# CC_FOR_TARGET is recorded as the default compiler for the go tool. When building for the host, however,
 	# use the host compiler, CC, from `cmd/dist/dist env` instead.
@@ -169,11 +179,22 @@ if [ "$GOHOSTARCH" != "$GOARCH" -o "$GOHOSTOS" != "$GOOS" ]; then
 	echo
 fi
 
-echo "##### Building packages and commands for $GOOS/$GOARCH."
-CC="$CC_FOR_TARGET" "$GOTOOLDIR"/go_bootstrap install $GO_FLAGS -gcflags "$GO_GCFLAGS" -ldflags "$GO_LDFLAGS" -v std cmd
-echo
 
-rm -f "$GOTOOLDIR"/go_bootstrap
+if [ "$do_target_build" = "yes" ]; then
+    GO_INSTALL="${GO_TARGET_INSTALL:-std cmd}"
+    echo "##### Building packages and commands for $GOOS/$GOARCH."
+    if [ "$GOHOSTOS" = "$GOOS" -a "$GOHOSTARCH" = "$GOARCH" -a "$do_host_build" = "yes" ]; then
+       rm -rf ./host-tools
+       mkdir ./host-tools
+       mv "$GOTOOLDIR"/* ./host-tools
+       GOTOOLDIR="$PWD/host-tools"
+    fi
+    GOTOOLDIR="$GOTOOLDIR" CC="$CC_FOR_TARGET" "$GOTOOLDIR"/go_bootstrap install $GO_FLAGS -gcflags "$GO_GCFLAGS" -ldflags "$GO_LDFLAGS" -v ${GO_INSTALL}
+    echo
+
+    rm -f "$GOTOOLDIR"/go_bootstrap
+fi
+
 
 if [ "$1" != "--no-banner" ]; then
 	"$GOTOOLDIR"/dist banner
-- 
2.7.4

