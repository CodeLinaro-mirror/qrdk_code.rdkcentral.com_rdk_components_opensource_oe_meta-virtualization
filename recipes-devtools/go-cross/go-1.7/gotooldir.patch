From: xione
Subject: Use correct version of runc for sky-dobby
Source: COMCAST
License: GPLV2
Upstream-Status: Pending
Signed-off-by: Kamal Mortoza <kamal.mortoza@sky.uk>

From 2518ed04c46f7e060b688b1706e20cb40ae92a5f Mon Sep 17 00:00:00 2001
From: Antti Kyllonen <antti.kyllonen@redembedded.com>
Date: Mon, 21 Oct 2019 16:48:32 +0100
Subject: [PATCH] gotooldir

---
 src/cmd/go/build.go   | 2 +-
 src/go/build/build.go | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/cmd/go/build.go b/src/cmd/go/build.go
index 5baae1a..6ed82b2 100644
--- a/src/cmd/go/build.go
+++ b/src/cmd/go/build.go
@@ -1443,7 +1443,7 @@ func (b *builder) build(a *action) (err error) {
 		}
 
 		cgoExe := tool("cgo")
-		if a.cgo != nil && a.cgo.target != "" {
+		if a.cgo != nil && a.cgo.target != "" && os.Getenv("GOTOOLDIR") == "" {
 			cgoExe = a.cgo.target
 		}
 		outGo, outObj, err := b.cgo(a.p, cgoExe, obj, pcCFLAGS, pcLDFLAGS, cgofiles, gccfiles, cxxfiles, a.p.MFiles, a.p.FFiles)
diff --git a/src/go/build/build.go b/src/go/build/build.go
index 9706b8b..5db8c37 100644
--- a/src/go/build/build.go
+++ b/src/go/build/build.go
@@ -1513,7 +1513,7 @@ func init() {
 }
 
 // ToolDir is the directory containing build tools.
-var ToolDir = filepath.Join(runtime.GOROOT(), "pkg/tool/"+runtime.GOOS+"_"+runtime.GOARCH)
+var ToolDir = envOr("GOTOOLDIR", filepath.Join(runtime.GOROOT(), "pkg/tool/"+runtime.GOOS+"_"+runtime.GOARCH))
 
 // IsLocalImport reports whether the import path is
 // a local import path, like ".", "..", "./foo", or "../foo".
-- 
